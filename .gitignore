# ---------------------------------------------------------------------------
# Crush Depth — .gitignore
# Rule of thumb: anything a fresh `npm install && npm run build` can recreate
# does not belong in git. Specs, source and decision records always do.
# ---------------------------------------------------------------------------

# --- Dependencies ---------------------------------------------------------
node_modules/
.pnpm-store/
.pnp
.pnp.*
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.yarn-integrity

# --- Build output ---------------------------------------------------------
# packages/*/dist (tsc outDir), apps/client/dist (vite build)
dist/
build/
# apps/client emits declarations to dist-types (see apps/client/tsconfig.json)
dist-types/
*.tsbuildinfo

# --- Caches ---------------------------------------------------------------
.vite/
.cache/
.temp/
.tmp/
.turbo/
.eslintcache
.stylelintcache
.prettiercache
.npm/
.rollup.cache/
.vite-inspect/
vite.config.*.timestamp-*

# --- Test / coverage output ----------------------------------------------
coverage/
*.lcov
.nyc_output/
# Vitest / Playwright artifacts
.vitest/
html/
test-results/
playwright-report/
blob-report/
.playwright/
playwright/.auth/
junit.xml
vitest-results*.json

# --- Secrets and local config --------------------------------------------
# Audit note: no secret may ever be committed. Remote config (θ and friends)
# lives outside the repo — see CLAUDE.md invariant 7.
.env
.env.*
!.env.example
.envrc
.envrc.*
!.envrc.example
.npmrc.local
.yarnrc.local.yml
credentials.local.json
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
secrets.json

# --- Local tool state -----------------------------------------------------
.claude/settings.local.json
.serena/
.aider*
.vercel/
.netlify/

# --- Logs -----------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
pids/
*.pid
*.pid.lock
.node_repl_history

# --- Editors --------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.vs/
.history/
*.code-workspace
*.suo
*.user
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# --- OS -------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
.directory
$RECYCLE.BIN/

# --- Temporary / backup files ---------------------------------------------
*.tmp
*.temp
*.bak
*.orig
*~

# --- Recorded feed data ---------------------------------------------------
# ReplayIndexSource (M1.6) replays recorded BTC 100 ms files. Small committed
# fixtures live under packages/feed/fixtures/ and are kept; bulk captures are
# not. Drop large captures in data/recordings/.
data/recordings/
*.ticks.jsonl
*.ticks.csv

# --- Simulation output ----------------------------------------------------
# packages/sim (M1.7) writes Monte-Carlo report artifacts; the calibrated
# result is recorded in the spec, not as a committed blob.
packages/sim/out/
packages/sim/reports/

# --- Misc archives --------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
