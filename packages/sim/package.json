{
  "name": "@crush/sim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic Monte-Carlo RTP calibration harness and behavior models; emits preliminary and release-scale report data.",
  "scripts": {
    "calibrate": "node ./scripts/generate-reference-report.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@crush/engine": "*",
    "@crush/feed": "*",
    "@crush/ledger": "*"
  }
}
